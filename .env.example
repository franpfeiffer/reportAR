# Neon PostgreSQL and Neon Auth (server-only)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
NEON_ORG_ID=org-dry-violet-82053526
NEON_PROJECT_ID=withered-sound-80419537
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=

# OAuth app credentials stay server-side. Configure provider credentials in Neon Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
NEXT_PUBLIC_ENABLE_VERCEL_OAUTH=false

# Application services
OPENAI_API_KEY=
AI_MOCK_MODE=true
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_DEMO_MODE=true

# Public link to the citizen reporting bot.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=reportAr_test_bot

# Bot ingestion (server only; REPORTS_API_TOKEN is also used by n8n Header Auth)
REPORTS_API_TOKEN=
# Same bot token configured in n8n; used only by the server to download photos
TELEGRAM_BOT_TOKEN=
# TypeSafe / Jev classification (server only; report description and declared category are sent)
TYPESAFE_API_KEY=
# Separate Neon storage project; never expose these to the browser
REPORT_IMAGES_BUCKET=report-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
